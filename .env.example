# Copy to .env and fill in. NEVER commit .env.
GNANI_API_KEY=your_gnani_key_here
# LLM: any OpenAI-compatible endpoint. Gemini:
LLM_API_KEY=your_llm_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
# Groq alternative:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

DRIVER_BOT_TOKEN=telegram_token_from_botfather
# Optional second bot for the office/owner. If empty, the driver bot serves the owner too.
OWNER_BOT_TOKEN=

# Optional: traffic-aware routes. Without it, OSRM routes (no traffic) are used.
GOOGLE_MAPS_API_KEY=
# Public URL of this server (e.g. Cloudflare Tunnel) for client tracking links
PUBLIC_BASE_URL=http://localhost:8080
HTTP_PORT=8080
# Optional: n8n webhook that receives fleet events
N8N_WEBHOOK_URL=
# Secret n8n must send as X-Saarthi-Key when calling this server's /api endpoints
API_SHARED_SECRET=change_me

# Speech settings
STT_MODEL=prisma-v3.0
STT_LANG_CANDIDATES=hi-IN,en-IN
TTS_MODEL=timbre-v2.5
TTS_VOICE=Poorvi
TTS_LANGUAGE=hi-IN
# mock = no API calls (development only; replies are text-only, transcripts from .txt sidecars)
SPEECH_MODE=gnani
DB_PATH=data/saarthi.db

# ---- Reasoning LLMs, tried in order (all OpenAI-compatible) ----
# LLM_* above is the primary. Add a fallback (e.g. Gnani-provided LLM key/endpoint as primary, Gemini as fallback):
# LLM_NAME=gnani
# LLM2_NAME=gemini
# LLM2_API_KEY=...
# LLM2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM2_MODEL=gemini-2.5-flash

# ---- Live companion (WebRTC) ----
# Phones on mobile data usually need a TURN server in addition to STUN:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:YOUR_TURN:3478","username":"u","credential":"p"}]
# Cloudflare TURN relay (recommended): Cloudflare dashboard -> Realtime -> TURN Server -> Create.
# Lets phones on mobile data reach the server even behind NAT. The key stays on the server.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# ...or free without a card (Metered, 20 GB/month): https://<app>.metered.live/api/v1/turn/credentials?apiKey=<key>
TURN_CREDENTIALS_URL=
# ...or Metered's fixed username + password (relay URLs default to global.relay.metered.ca)
TURN_USERNAME=
TURN_CREDENTIAL=
FATIGUE_INTERVAL_MIN=90

# ---- Music ----
# Radio streams you are licensed/allowed to play, as {"Name": "https://stream-url"}. Songs otherwise open a
# YouTube Music search on the phone.
RADIO_STATIONS={}

# ---- Deep reasoning (optional, slower and stronger model for think_deeply / analyze_business) ----
# REASONING_API_KEY=
# REASONING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# REASONING_MODEL=gemini-2.5-pro
