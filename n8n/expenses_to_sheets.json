{
  "name": "Saarthi - expenses to Google Sheets (hourly)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 * * * *"
            }
          ]
        }
      },
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "1"
    },
    {
      "parameters": {
        "url": "={{ $env.SAARTHI_URL }}/api/expenses?since={{ $now.minus({hours: 1}).toUTC().toISO() }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Saarthi-Key",
              "value": "={{ $env.SAARTHI_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Call Saarthi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "id": "2"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "PASTE_YOUR_SHEET_URL"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Expenses"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "name": "Append to Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        520,
        0
      ],
      "id": "3"
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Call Saarthi",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Saarthi": {
      "main": [
        [
          {
            "node": "Append to Google Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Asia/Kolkata"
  },
  "active": false
}