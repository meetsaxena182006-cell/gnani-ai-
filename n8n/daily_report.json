{
  "name": "Saarthi - daily owner report (8 PM)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 20 * * *"
            }
          ]
        }
      },
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "1"
    },
    {
      "parameters": {
        "url": "={{ $env.SAARTHI_URL }}/api/digest?send=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Saarthi-Key",
              "value": "={{ $env.SAARTHI_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Call Saarthi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "id": "2"
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Call Saarthi",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Asia/Kolkata"
  },
  "active": false
}